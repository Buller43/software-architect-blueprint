vars: {
  layout-engine: elk
}

direction: down

# ========================================================
# ACTORES EXTERNOS / ENTIDADES DE INTEGRACIÓN
# ========================================================
external_actors: "Frontera Externa (Tráfico No Confiable & APIs Bancarias/Fiscales)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 3

  merchant_client: {
    label: |||md
      **merchant_pos_client**
      Web Browser / Mobile POS / ERP
      Port: 443 / TLS 1.3
      Comercios & Compradores | Vol: client_app
    |||
    style: { fill: "#F5F5F5"; stroke: "#616161"; border-radius: 12; stroke-width: 2 }
  }

  bank_psp_gateway: {
    label: |||md
      **bank_psp_webhooks**
      Stripe / Adyen / SPEI / ACH
      Port: 443 / Webhook HTTPS
      Eventos de Cobro y Dispersión | Vol: ext_gateway
    |||
    style: { fill: "#FFF3E0"; stroke: "#EF6C00"; border-radius: 12; stroke-width: 2 }
  }

  tax_authority_api: {
    label: |||md
      **tax_authority_service**
      Hacienda / SAT / DIAN / SRI
      Port: 443 / HTTPS SOAP-REST
      PAC / Servicio de Timbrado Fiscal | Vol: gov_cloud
    |||
    style: { fill: "#FCE4EC"; stroke: "#C2185B"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# CAPA 1 & 2: SUBRED PERIMETRAL SEGURA (frontend_net)
# ========================================================
frontend_net: "Capa 1 & 2: Subred Perimetral & Ingress DMZ (frontend_net)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 3

  edge_waf_proxy: {
    label: |||md
      **edge_waf_proxy**
      Nginx:1.27 + ModSecurity-v3
      Port: 443 / TLS 1.3
      OWASP CRS v4 + Rate Limiter | Vol: certs_waf_vol
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }

  webhook_validator: {
    label: |||md
      **webhook_ingress_guard**
      Go:1.23 Edge Service
      Port: 8080 / HTTP (Internal)
      Validación Cripto HMAC-SHA256 | Vol: ephemeral_keys
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }

  web_portal: {
    label: |||md
      **merchant_portal_frontend**
      Node.js:20-alpine (Next.js 14)
      Port: 3000 / HTTP (Internal)
      Dashboard Multi-Tenant BFF | Vol: frontend_cache
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# CAPA 3 & 5: SUBRED DE SEGURIDAD, IAM & VAULT (security_net)
# ========================================================
security_net: "Capa 3 & 5: Control Plane, IAM & Bóveda Criptográfica (security_net)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 3

  iam_keycloak: {
    label: |||md
      **iam_keycloak**
      Keycloak:25.0-quarkus
      Port: 8443 / HTTPS
      OIDC Server & JWT (15m TTL) | Vol: keycloak_data_vol
    |||
    style: { fill: "#FFF3E0"; stroke: "#EF6C00"; border-radius: 12; stroke-width: 2 }
  }

  opa_policy_engine: {
    label: |||md
      **opa_policy_engine**
      OPA:0.67 (Open Policy Agent)
      Port: 8181 / REST
      Enforcer de Políticas RBAC/Tenant | Vol: opa_policies_vol
    |||
    style: { fill: "#FFF3E0"; stroke: "#EF6C00"; border-radius: 12; stroke-width: 2 }
  }

  vault_kms_cluster: {
    label: |||md
      **vault_kms_transit**
      HashiCorp-Vault:1.17 Clustered
      Port: 8200 / HTTPS (mTLS)
      Transit KEK + P12 en tmpfs RAM | Vol: vault_storage_vol
    |||
    style: { fill: "#FCE4EC"; stroke: "#C2185B"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# CAPA 4: SUBRED CORE TRANSACCIONAL & WORKERS (backend_net)
# ========================================================
backend_net: "Capa 4: Core Transaccional & Aislamiento de Cargas (backend_net)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 3

  api_core: {
    label: |||md
      **api_billing_core**
      Python:3.12-slim (FastAPI Async)
      Port: 8000 / HTTP (Internal)
      Orquestador & Idempotency Check | Vol: tmpfs_core_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }

  redis_ha_cluster: {
    label: |||md
      **redis_idempotency_cache**
      Redis:7.2-alpine (Sentinel HA)
      Port: 6379 / TLS
      SETNX Idempotency Locks | Vol: redis_data_vol
    |||
    style: { fill: "#FFF3E0"; stroke: "#EF6C00"; border-radius: 12; stroke-width: 2 }
  }

  message_broker: {
    label: |||md
      **rabbitmq_cluster**
      RabbitMQ:3.13-management
      Port: 5672 / AMQPS
      Priority Queues, Retries & DLX | Vol: rabbit_data_vol
    |||
    style: { fill: "#FFF3E0"; stroke: "#EF6C00"; border-radius: 12; stroke-width: 2 }
  }

  payment_worker: {
    label: |||md
      **worker_payments_priority**
      Python:3.12-slim (Celery Solo)
      Daemon / Cola: q_payments_priority
      Cobros & Conciliación Express | Vol: tmpfs_pay_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }

  fiscal_worker: {
    label: |||md
      **worker_fiscal_stamper**
      Python:3.12-slim (Circuit Breaker)
      Daemon / Retry Exponential + DLQ
      Timbrado Fiscal con Fallback | Vol: tmpfs_ram_certs
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }

  docgen_worker: {
    label: |||md
      **worker_docgen_bulkhead**
      Python:3.12-slim (WeasyPrint)
      Daemon / CPU-Mem Restricted
      Render Aislado PDF/XML Fiscal | Vol: tmpfs_doc_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# CAPA 6: SUBRED DE DATOS DE ALTA DISPONIBILIDAD (data_net)
# ========================================================
data_net: "Capa 6: Persistencia Segura HA & Almacén S3 WORM (data_net)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 2

  pgbouncer_pool: {
    label: |||md
      **pgbouncer_pooler**
      PgBouncer:1.22-alpine
      Port: 6432 / SSL (Internal)
      Pooling Transaccional | Vol: pgbouncer_conf
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }

  minio_s3_storage: {
    label: |||md
      **minio_s3_worm**
      MinIO:RELEASE.2024-08
      Port: 9000 / HTTPS (Internal)
      WORM Inmutable + AES-256 SSE | Vol: minio_storage_vol
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }

  db_primary: {
    label: |||md
      **db_postgres_primary**
      PostgreSQL:16-alpine (Patroni HA)
      Port: 5432 / SSL Verify-Full
      Master Escrituras + RLS + pgaudit | Vol: pg_primary_vol
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }

  db_replica: {
    label: |||md
      **db_postgres_read_replica**
      PostgreSQL:16-alpine (Streaming)
      Port: 5432 / SSL Verify-Full
      Hot Standby Lecturas & Reportería | Vol: pg_replica_vol
    |||
    style: { fill: "#E8F5E9"; stroke: "#2E7D32"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# SUBRED DE TELEMETRÍA & SECOPS (observability_net)
# ========================================================
observability_net: "Monitoreo, Auditoría & Alerting (observability_net)" {
  style: {
    fill: "#F5F5F5"
    stroke: "#616161"
    stroke-width: 2
    stroke-dash: 3
    border-radius: 12
  }
  grid-columns: 4

  prometheus_telemetry: {
    label: |||md
      **prometheus_metrics**
      Prometheus:v2.54.0
      Port: 9090 / HTTP
      Métricas Circuit Breaker & Queues | Vol: prom_data_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }

  loki_audit_logs: {
    label: |||md
      **loki_audit_logs**
      Grafana-Loki:3.1.0
      Port: 3100 / HTTP
      Trazas Forenses pgaudit & WAF | Vol: loki_data_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }

  alertmanager_ops: {
    label: |||md
      **alertmanager_secops**
      Alertmanager:0.27
      Port: 9093 / HTTP
      Alertas DLQ Spike & Circuit OPEN | Vol: alert_conf_vol
    |||
    style: { fill: "#FCE4EC"; stroke: "#C2185B"; border-radius: 12; stroke-width: 2 }
  }

  grafana_dashboard: {
    label: |||md
      **grafana_dashboard**
      Grafana:11.1.0
      Port: 3000 / HTTP
      SLOs Financieros & Panel SecOps | Vol: grafana_data_vol
    |||
    style: { fill: "#E3F2FD"; stroke: "#1565C0"; border-radius: 12; stroke-width: 2 }
  }
}

# ========================================================
# CONEXIONES VERTICALES Y FLUJOS ZERO TRUST
# ========================================================
external_actors -> frontend_net: "Tráfico Público HTTPS / Webhooks"
frontend_net -> backend_net: "Tráfico L7 Filtrado"
backend_net -> security_net: "mTLS Tokens, Auth & KEK"
backend_net -> data_net: "Pool Transaccional & Persistencia WORM"
backend_net -> observability_net: "Métricas & Logs de Auditoría"

# Interacciones clave de nodos
external_actors.merchant_client -> frontend_net.edge_waf_proxy: "HTTPS 443"
external_actors.bank_psp_gateway -> frontend_net.webhook_validator: "HMAC-SHA256"

frontend_net.edge_waf_proxy -> backend_net.api_core: "Forward API Request"
frontend_net.webhook_validator -> backend_net.api_core: "Validated Webhook Event"

backend_net.api_core -> backend_net.redis_ha_cluster: "SETNX Idempotency Lock"
backend_net.api_core -> backend_net.message_broker: "AMQPS Dispatch"

backend_net.message_broker -> backend_net.payment_worker: "q_payments_priority"
backend_net.message_broker -> backend_net.fiscal_worker: "q_fiscal_stamping"
backend_net.message_broker -> backend_net.docgen_worker: "q_docgen_bulkhead"

backend_net.fiscal_worker -> security_net.vault_kms_cluster: "Decrypt P12 into tmpfs RAM"
backend_net.fiscal_worker -> external_actors.tax_authority_api: "Timbrado Fiscal (Circuit Breaker)"

backend_net.docgen_worker -> data_net.minio_s3_storage: "Upload Signed PDF/XML"

backend_net.api_core -> data_net.pgbouncer_pool: "Transaccional Read/Write"
data_net.pgbouncer_pool -> data_net.db_primary: "Writes + RLS"
data_net.pgbouncer_pool -> data_net.db_replica: "Reads"
data_net.db_primary -> data_net.db_replica: "Streaming Replication"
