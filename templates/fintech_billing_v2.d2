# ========================================================
# FLUJOS ENTRE BANDAS (SECUENCIALES Y LOCALES)
# ========================================================
external_actors -> frontend_net: "Tráfico HTTPS 443 / Webhooks"
frontend_net -> backend_net: "Tráfico L7 Filtrado"
backend_net -> security_net: "mTLS Tokens, Auth & Transit KMS"
backend_net -> data_net: "Transaccional Read/Write & S3 WORM"
backend_net -> observability_net: "Telemetría & Trazas Forenses"

# ========================================================
# BARRAS TRANSVERSALES INFERIORES DE RESUMEN (WIDTH: 854)
# ========================================================
bar_volumes: {
  width: 854
  style: {
    fill: "#F5F5F5"
    stroke: "#9E9E9E"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Volúmenes Persistentes (Named Volumes)
    · `certs_waf_vol` · `keycloak_data_vol` · `vault_storage_vol` · `rabbit_data_vol` · `redis_data_vol` · `pg_primary_vol` · `pg_replica_vol` · `minio_storage_vol` · `prom_data_vol` · `loki_data_vol`
  |||
}

bar_secrets: {
  width: 854
  style: {
    fill: "#FDF3E7"
    stroke: "#E68A00"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Gestión de Secretos — CERO .env en Código Fuente
    · Vault KV v2 con rotación de leasing · Transit KMS descifra certificados digitales `.p12` exclusivamente en `tmpfs` RAM volátil sin tocar disco
  |||
}

bar_networks: {
  width: 854
  style: {
    fill: "#E8F1FA"
    stroke: "#4A89DC"
    stroke-width: 1
    border-radius: 10
  }
