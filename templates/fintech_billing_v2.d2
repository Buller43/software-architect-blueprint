direction: down
grid-columns: 1
grid-gap: 16

# ========================================================
# PALETA PASTEL SEMÁNTICA OFICIAL (BORDER-RADIUS: 10)
# ========================================================
classes: {
  mint: {
    style: {
      fill: "#EBF7EE"
      stroke: "#43A047"
      font-color: "#1B5E20"
      border-radius: 10
      stroke-width: 2
    }
  }
  sky: {
    style: {
      fill: "#E8F1FA"
      stroke: "#4A89DC"
      font-color: "#1A237E"
      border-radius: 10
      stroke-width: 2
    }
  }
  lavender: {
    style: {
      fill: "#EFEBF9"
      stroke: "#7E57C2"
      font-color: "#311B92"
      border-radius: 10
      stroke-width: 2
    }
  }
  amber: {
    style: {
      fill: "#FDF3E7"
      stroke: "#E68A00"
      font-color: "#4E342E"
      border-radius: 10
      stroke-width: 2
    }
  }
  rose: {
    style: {
      fill: "#FCECEF"
      stroke: "#D85C72"
      font-color: "#4A151B"
      border-radius: 10
      stroke-width: 2
    }
  }
}

# ========================================================
# 1. FRONTERA EXTERNA & ACTORES (WIDTH: 854)
# ========================================================
external_actors: "Frontera Externa & APIs Bancarias/Fiscales" {
  width: 854
  style: {
    fill: "#FAFAFA"
    stroke: "#BDBDBD"
    stroke-width: 1
    border-radius: 10
  }
  grid-columns: 3
  grid-gap: 18

  merchant_client: {
    width: 260
    label: |||md
      ### merchant_pos_client
      **Browser / POS / Mobile**
      · Port 443 · TLS 1.3
      · Comercios & Compradores
    |||
    style: { fill: "#F5F5F5"; stroke: "#9E9E9E"; border-radius: 10; stroke-width: 2 }
  }

  bank_psp_gateway: {
    class: amber
    width: 260
    label: |||md
      ### bank_psp_webhooks
      **Stripe / SPEI / Adyen**
      · Port 443 · Webhook HTTPS
      · Eventos de Cobro y Dispersión
    |||
  }

  tax_authority_api: {
    class: rose
    width: 260
    label: |||md
      ### tax_authority_service
      **Hacienda / SAT / DIAN**
      · Port 443 · HTTPS SOAP-REST
      · PAC / Timbrado Fiscal
    |||
  }
}

