    stroke-width: 1
    border-radius: 10
  }
  hardened_db: {
    class: mint
    width: 400
    label: |||md
      ### hardened_db
      **PostgreSQL 16 Alpine**
      · Port 5432 · SSL verify-full
      · AES-256 + RLS · pg_data
    |||
  }
}

# ========================================================
# FLUJO VERTICAL SECUENCIAL ENTRE CAPAS
# ========================================================
layer_1_perimeter -> layer_2_waf: "1. TLS 1.3 Decrypt & Filter"
layer_2_waf -> layer_3_iam: "2. OIDC Token Verify"
layer_3_iam -> layer_4_jailing: "3. Validated Traffic Ingress"
layer_4_jailing -> layer_5_split: "4. mTLS Dynamic Secrets & Audit"
layer_5_split -> layer_6_persistence: "5. Ephemeral Credentials to RLS"
layer_6_persistence -> rbac_matrix: "6. Granular Policy Enforcement"

# ========================================================
# MATRIZ RBAC (WIDTH: 854, GRID-COLUMNS: 4)
# ========================================================
