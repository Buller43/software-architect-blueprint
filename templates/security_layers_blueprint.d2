    · `frontend_net` (edge_perimeter, waf_modsec) · `security_net` (keycloak, opa, vault) · `backend_net` (jailed_backend, hardened_db) · `observability_net` (audit_compliance)
  |||
}

bar_resilience: {
  width: 854
  style: {
    fill: "#EBF7EE"
    stroke: "#43A047"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
