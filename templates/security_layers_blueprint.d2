}

# ========================================================
# BARRAS TRANSVERSALES INFERIORES DE RESUMEN (WIDTH: 854)
# ========================================================
bar_volumes: {
  width: 854
  style: {
    fill: "#F5F5F5"
    stroke: "#9E9E9E"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Volúmenes Persistentes (Named Volumes)
    · `ssl_certs_vol` · `crs_rules_vol` · `sso_data_vol` · `opa_rules_vol` · `tmpfs_ram_vol` · `vlt_data_vol` · `lki_data_vol` · `pg_data_vol`
  |||
}

bar_secrets: {
  width: 854
  style: {
    fill: "#FDF3E7"
    stroke: "#E68A00"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
