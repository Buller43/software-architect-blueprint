    · HashiCorp Vault KV v2 con rotación de leasing · Claves RSA/JWT y contraseñas DB montadas exclusivamente en `tmpfs` RAM volátil
  |||
}

bar_networks: {
  width: 854
  style: {
    fill: "#E8F1FA"
    stroke: "#4A89DC"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
