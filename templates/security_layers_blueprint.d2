direction: down
grid-columns: 1
grid-gap: 16

# ========================================================
# PALETA PASTEL SEMÁNTICA OFICIAL (BORDER-RADIUS: 10)
# ========================================================
classes: {
  mint: {
    style: {
      fill: "#EBF7EE"
      stroke: "#43A047"
      font-color: "#1B5E20"
      border-radius: 10
      stroke-width: 2
    }
  }
  sky: {
    style: {
      fill: "#E8F1FA"
      stroke: "#4A89DC"
      font-color: "#1A237E"
      border-radius: 10
      stroke-width: 2
    }
  }
  lavender: {
    style: {
      fill: "#EFEBF9"
      stroke: "#7E57C2"
      font-color: "#311B92"
      border-radius: 10
      stroke-width: 2
    }
  }
  amber: {
    style: {
      fill: "#FDF3E7"
      stroke: "#E68A00"
      font-color: "#4E342E"
      border-radius: 10
      stroke-width: 2
    }
  }
  rose: {
    style: {
      fill: "#FCECEF"
      stroke: "#D85C72"
      font-color: "#4A151B"
      border-radius: 10
      stroke-width: 2
    }
  }
}

# ========================================================
# CAPA 1: PERÍMETRO DE RED & INGRESS TLS 1.3
# ========================================================
layer_1_perimeter: "Capa 1: Perímetro de Red & Ingress TLS 1.3" {
  width: 820
  style: {
    fill: "#FAFAFA"
    stroke: "#BDBDBD"
    stroke-width: 1
    border-radius: 10
  }
  edge_perimeter: {
    class: mint
    width: 400
    label: |||md
      ### edge_perimeter_guard
      **HAProxy 2.9 + Fail2Ban**
      · Port 443 · TLS 1.3 Estricto
      · DDoS Mitigation · ssl_certs
    |||
  }
}

# ========================================================
# CAPA 2: INSPECCIÓN WAF & CABECERAS HTTP
