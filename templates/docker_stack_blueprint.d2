direction: down
grid-columns: 1
grid-gap: 16

# ========================================================
# PALETA PASTEL SEMÁNTICA OFICIAL (BORDER-RADIUS: 10)
# ========================================================
classes: {
  mint: {
    style: {
      fill: "#EBF7EE"
      stroke: "#43A047"
      font-color: "#1B5E20"
      border-radius: 10
      stroke-width: 2
    }
  }
  sky: {
    style: {
      fill: "#E8F1FA"
      stroke: "#4A89DC"
      font-color: "#1A237E"
      border-radius: 10
      stroke-width: 2
    }
  }
  lavender: {
    style: {
      fill: "#EFEBF9"
      stroke: "#7E57C2"
      font-color: "#311B92"
      border-radius: 10
      stroke-width: 2
    }
  }
  amber: {
    style: {
      fill: "#FDF3E7"
      stroke: "#E68A00"
      font-color: "#4E342E"
      border-radius: 10
      stroke-width: 2
    }
  }
  rose: {
    style: {
      fill: "#FCECEF"
      stroke: "#D85C72"
      font-color: "#4A151B"
      border-radius: 10
      stroke-width: 2
    }
  }
}

# ========================================================
# MATRIZ 3x4: TOPOLOGÍA DE SERVICIOS (WIDTH: 854)
# ========================================================
services_grid: "Topología de Servicios Docker (12 Componentes en Matriz 3x4)" {
  width: 854
  style: {
    fill: "#FAFAFA"
    stroke: "#BDBDBD"
    stroke-width: 1
    border-radius: 10
  }
  grid-columns: 4
  grid-gap: 18

  # --- FILA 1: PERÍMETRO, FRONTEND, AUTENTICACIÓN Y BÓVEDA ---
  edge_waf_proxy: {
    class: mint
    width: 200
    label: |||md
      ### edge_waf_proxy
      **Nginx 1.27 + ModSec**
      · Port 443 · TLS 1.3
      · Ingress WAF · certs_vol
    |||
  }

  web_frontend: {
    class: lavender
    width: 200
    label: |||md
      ### web_frontend
      **Next.js 14 Alpine**
      · Port 3000 · HTTP
      · BFF SSR · node_cache
    |||
  }

  iam_keycloak: {
    class: amber
    width: 200
    label: |||md
      ### iam_keycloak
      **Keycloak 25 Quarkus**
      · Port 8443 · HTTPS
      · OIDC & RBAC · sso_data
    |||
  }

  secrets_vault: {
    class: rose
    width: 200
    label: |||md
      ### secrets_vault
      **HashiCorp Vault 1.17**
      · Port 8200 · mTLS
      · KV v2 · vlt_data
    |||
  }

  # --- FILA 2: CÓMPUTO CORE, WORKERS, BROKER Y STORAGE ---
  api_backend: {
    class: sky
    width: 200
    label: |||md
      ### api_backend
      **FastAPI 0.112 py3.12**
      · Port 8000 · HTTP
      · Core REST · app_tmpfs
    |||
  }

  async_worker: {
    class: rose
    width: 200
    label: |||md
      ### async_worker
      **Celery 5.4 py3.12**
      · Daemon · No Port
      · Async Tasks · wrk_tmpfs
    |||
  }

  redis_broker: {
    class: amber
    width: 200
    label: |||md
      ### redis_broker
      **Redis 7.2 Alpine**
      · Port 6379 · TLS
      · Cache & Queue · rds_data
    |||
  }

  minio_storage: {
    class: rose
    width: 200
    label: |||md
      ### minio_storage
      **MinIO S3 RELEASE.2024**
      · Port 9000 · S3 API
      · AES-256 S3 · s3_data
    |||
  }

  # --- FILA 3: PERSISTENCIA Y TELEMETRÍA SECOPS ---
  postgres_db: {
    class: mint
    width: 200
    label: |||md
      ### postgres_db
      **PostgreSQL 16 Alpine**
      · Port 5432 · SSL
      · RLS + pgaudit · pg_data
    |||
  }

  prometheus_tsdb: {
    class: sky
    width: 200
    label: |||md
      ### prometheus_tsdb
      **Prometheus v2.54**
      · Port 9090 · HTTP
      · Metrics Scrape · prom_data
    |||
  }

  loki_logs: {
    class: sky
    width: 200
    label: |||md
      ### loki_logs
      **Grafana Loki 3.1**
      · Port 3100 · HTTP
      · Log Collector · lki_data
    |||
  }

  grafana_dash: {
    class: sky
    width: 200
    label: |||md
      ### grafana_dash
      **Grafana 11.1**
      · Port 3000 · HTTP
      · SecOps Panel · grf_data
    |||
  }
}

# ========================================================
# CONEXIONES DIRECTAS Y LOCALES ENTRE SERVICIOS
# ========================================================
services_grid.edge_waf_proxy -> services_grid.web_frontend: "Proxy Ingress (3000)"
services_grid.edge_waf_proxy -> services_grid.api_backend: "API Ingress (8000)"
services_grid.api_backend -> services_grid.iam_keycloak: "Token Introspect (8443)"
services_grid.api_backend -> services_grid.secrets_vault: "Dynamic Leases (8200)"
services_grid.api_backend -> services_grid.redis_broker: "Cache & Lock (6379)"
services_grid.api_backend -> services_grid.postgres_db: "SQL / SSL · RLS (5432)"
services_grid.api_backend -> services_grid.minio_storage: "Presigned S3 (9000)"

services_grid.async_worker -> services_grid.redis_broker: "Task Queue Pop (6379)"
services_grid.async_worker -> services_grid.postgres_db: "Write Results (5432)"
services_grid.async_worker -> services_grid.secrets_vault: "mTLS Leases (8200)"

services_grid.prometheus_tsdb -> services_grid.api_backend: "Scrape /metrics"
services_grid.grafana_dash -> services_grid.prometheus_tsdb: "PromQL Queries"
services_grid.grafana_dash -> services_grid.loki_logs: "LogQL Queries"

# ========================================================
# BARRAS TRANSVERSALES INFERIORES DE RESUMEN (WIDTH: 854)
# ========================================================
bar_volumes: {
  width: 854
  style: {
    fill: "#F5F5F5"
    stroke: "#9E9E9E"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Volúmenes Persistentes (Named Volumes)
    · `certs_waf_vol` · `node_cache_vol` · `sso_data_vol` · `vlt_data_vol` · `app_tmpfs` · `wrk_tmpfs` · `rds_data_vol` · `s3_data_vol` · `pg_data_vol` · `prom_data_vol` · `lki_data_vol` · `grf_data_vol`
  |||
}

bar_secrets: {
  width: 854
  style: {
    fill: "#FDF3E7"
    stroke: "#E68A00"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Gestión de Secretos — CERO .env en Código Fuente
    · Inyección dinámica vía HashiCorp Vault KV v2 con rotación automática de leasing · Tokens efímeros en `tmpfs` RAM · Credenciales PostgreSQL, S3 y JWT rotadas sin reiniciar contenedores
  |||
}

bar_networks: {
  width: 854
  style: {
    fill: "#E8F1FA"
    stroke: "#4A89DC"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Segmentación de Redes Zero Trust
    · `frontend_net` (edge_waf, web_frontend) · `security_net` (iam_keycloak, secrets_vault, api_backend) · `backend_net` (api_backend, async_worker, redis_broker, postgres_db) · `media_net` (minio, backend, worker) · `observability_net`
  |||
}

bar_resilience: {
  width: 854
  style: {
    fill: "#EBF7EE"
    stroke: "#43A047"
    stroke-width: 1
    border-radius: 10
  }
  label: |||md
    ### Resiliencia y Health Checks
    · `restart: unless-stopped` en los 12 servicios · `depends_on: service_healthy` en cascada · Circuit Breakers con DLQ en workers · Readiness probes `/healthz`
  |||
}
